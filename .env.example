# NEXORA environment configuration
# Copy to .env.local and fill in values. The app runs fully in demo mode
# with no external services: if AI_API_KEY is empty, the MockAIProvider is used.

# --- Application ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://mongodb:27017/nexora

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Authentication ---
# Use `openssl rand -base64 32` to generate a strong secret
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- AI Provider ---
# Options: mock | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ---
# Options: local | s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=nexora
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto

# --- Vector search ---
# Options: mock | mongo (mongo requires MongoDB Atlas vector search)
VECTOR_SEARCH_PROVIDER=mock

# --- Billing ---
# Mock provider is used when keys are empty
BILLING_PROVIDER=mock
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=

# --- Queue ---
REDIS_QUEUE_PREFIX=nexora

# --- Email ---
# Mock mailer used when unset (logs emails to console)
EMAIL_PROVIDER=mock
SMTP_URL=

# --- Demo account (created by seed) ---
DEMO_EMAIL=demo@nexora.app
DEMO_PASSWORD=DemoPass123!
